import pygame
import random
import sys

pygame.init()

# Screen
WIDTH = 400
HEIGHT = 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Flappy Bird")

clock = pygame.time.Clock()

# Colors
SKY = (135, 206, 235)
GREEN = (50, 180, 70)
YELLOW = (255, 220, 0)
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)

# Bird
bird_x = 80
bird_y = HEIGHT // 2
bird_radius = 15
velocity = 0
gravity = 0.5
jump = -9

# Pipes
pipe_width = 60
pipe_gap = 160
pipe_speed = 3

pipes = []

def create_pipe():
    gap_y = random.randint(150, 400)
    pipes.append({
        "x": WIDTH,
        "gap_y": gap_y,
        "passed": False
    })

create_pipe()

score = 0
font = pygame.font.Font(None, 50)
game_over = False

while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE and not game_over:
                velocity = jump

            if event.key == pygame.K_SPACE and game_over:
                # Restart
                bird_y = HEIGHT // 2
                velocity = 0
                pipes.clear()
                create_pipe()
                score = 0
                game_over = False

    if not game_over:
        # Bird movement
        velocity += gravity
        bird_y += velocity

        # Move pipes
        for pipe in pipes:
            pipe["x"] -= pipe_speed

        # Add new pipe
        if pipes[-1]["x"] < WIDTH - 200:
            create_pipe()

        # Remove old pipes
        pipes = [p for p in pipes if p["x"] > -pipe_width]

        # Score
        for pipe in pipes:
            if not pipe["passed"] and pipe["x"] + pipe_width < bird_x:
                score += 1
                pipe["passed"] = True

        # Collision with ground/ceiling
        if bird_y - bird_radius <= 0 or bird_y + bird_radius >= HEIGHT:
            game_over = True

        # Collision with pipes
        bird_rect = pygame.Rect(
            bird_x - bird_radius,
            bird_y - bird_radius,
            bird_radius * 2,
            bird_radius * 2
        )

        for pipe in pipes:
            top_pipe = pygame.Rect(
                pipe["x"],
                0,
                pipe_width,
                pipe["gap_y"] - pipe_gap // 2
            )

            bottom_pipe = pygame.Rect(
                pipe["x"],
                pipe["gap_y"] + pipe_gap // 2,
                pipe_width,
                HEIGHT
            )

            if bird_rect.colliderect(top_pipe) or bird_rect.colliderect(bottom_pipe):
                game_over = True

    # Draw background
    screen.fill(SKY)

    # Draw pipes
    for pipe in pipes:
        top_height = pipe["gap_y"] - pipe_gap // 2
        bottom_y = pipe["gap_y"] + pipe_gap // 2

        pygame.draw.rect(
            screen, GREEN,
            (pipe["x"], 0, pipe_width, top_height)
        )

        pygame.draw.rect(
            screen, GREEN,
            (pipe["x"], bottom_y, pipe_width, HEIGHT - bottom_y)
        )

    # Draw bird
    pygame.draw.circle(
        screen, YELLOW,
        (bird_x, int(bird_y)),
        bird_radius
    )

    # Score
    score_text = font.render(str(score), True, WHITE)
    screen.blit(score_text, (WIDTH // 2 - 10, 30))

    # Game over
    if game_over:
        text = font.render("GAME OVER", True, BLACK)
        restart = pygame.font.Font(None, 30).render(
            "Press SPACE to restart", True, BLACK
        )

        screen.blit(text, (WIDTH // 2 - 100, HEIGHT // 2 - 40))
        screen.blit(restart, (WIDTH // 2 - 120, HEIGHT // 2 + 20))

    pygame.display.update()
    clock.tick(60)
